# ── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-7

# ── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=changeme-set-in-env

# ── Database (Postgres — get from Neon dashboard) ───────────────────────────
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── CORS (only set in production on Railway) ────────────────────────────────
# Comma-separated allowed origins. Defaults to "*" if unset.
# Example: CORS_ORIGINS=https://stalk.vercel.app
# CORS_ORIGINS=*
